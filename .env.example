# Gateflow local environment (copy to .env — never commit secrets)

ENVIRONMENT=local
LOG_LEVEL=info

# Dev auth
GATEFLOW_DEV_JWT_SECRET=gateflow-dev-secret-change-me

# PostgreSQL
POSTGRES_USER=gateflow
POSTGRES_PASSWORD=gateflow
POSTGRES_DB=gateflow
# Prefer role+search_path per service (examples):
# DATABASE_URL=postgres://sale_app:sale_app@localhost:5432/gateflow?sslmode=disable&search_path=sale
DATABASE_URL=postgres://gateflow:gateflow@localhost:5432/gateflow?sslmode=disable
SALE_DATABASE_URL=postgres://gateflow:gateflow@localhost:5432/gateflow?sslmode=disable&search_path=sale
ADMISSION_DATABASE_URL=postgres://gateflow:gateflow@localhost:5432/gateflow?sslmode=disable&search_path=admission
INVENTORY_DATABASE_URL=postgres://gateflow:gateflow@localhost:5432/gateflow?sslmode=disable&search_path=inventory
ORDER_DATABASE_URL=postgres://gateflow:gateflow@localhost:5432/gateflow?sslmode=disable&search_path=order
PAYMENT_DATABASE_URL=postgres://gateflow:gateflow@localhost:5432/gateflow?sslmode=disable&search_path=payment

# Redis
REDIS_ADDR=localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_ENABLED=true

# Observability (P5.4.0) — optional; does not affect booking correctness if off/unreachable
# GATEFLOW_OTEL_ENABLED=1
# GATEFLOW_OTEL_ENDPOINT=localhost:4318


# Service HTTP bind addresses
SALE_HTTP_ADDR=:8081
ADMISSION_HTTP_ADDR=:8082
INVENTORY_HTTP_ADDR=:8083
ORDER_HTTP_ADDR=:8084
PAYMENT_HTTP_ADDR=:8085

# Frontend API bases (Vite)
VITE_SALE_API_BASE=http://localhost:8081
VITE_ADMISSION_API_BASE=http://localhost:8082
VITE_ORDER_API_BASE=http://localhost:8084
