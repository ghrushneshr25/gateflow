# Static frontend (Vite build) served by nginx.
# build-arg APP=buyer-web|operator-console
# Buyer and admin are separate images/deployments.
ARG APP=buyer-web
FROM node:22-alpine AS build
ARG APP
WORKDIR /src
COPY apps/${APP}/package.json apps/${APP}/package-lock.json* ./
RUN npm ci || npm install
COPY apps/${APP}/ ./
# Browser → host port-forwards (k8s-ui-up maps 8081–8085, 8088 buyer, 8089 admin)
ARG VITE_SALE_API_BASE=http://127.0.0.1:8081
ARG VITE_ADMISSION_API_BASE=http://127.0.0.1:8082
ARG VITE_ORDER_API_BASE=http://127.0.0.1:8084
ARG VITE_DEV_JWT_SECRET=gateflow-dev-secret-change-me
ARG VITE_GOOGLE_CLIENT_ID=
ENV VITE_SALE_API_BASE=$VITE_SALE_API_BASE \
    VITE_ADMISSION_API_BASE=$VITE_ADMISSION_API_BASE \
    VITE_ORDER_API_BASE=$VITE_ORDER_API_BASE \
    VITE_DEV_JWT_SECRET=$VITE_DEV_JWT_SECRET \
    VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY deployments/docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
